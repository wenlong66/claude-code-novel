{
  "mcpServers": {
    "context7": {
      "args": [
        "/c",
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ],
      "command": "cmd",
      "type": "stdio"
    },
    "fetch": {
      "args": [
        "mcp-server-fetch"
      ],
      "command": "uvx",
      "type": "stdio"
    },
    "filesystem": {
      "args": [
        "/c",
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "E:/work"
      ],
      "command": "cmd"
    }
  }
}